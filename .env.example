# ─────────────────────────────────────────────────────────────────────────────
# Seedwel Office — environment configuration
# Copy to `.env.local` for local development and add the same keys in Vercel.
# Firebase keys are REQUIRED for sign-in and saving documents. Without them
# account creation and workspace access are unavailable (no demo fallback).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Authentication + Cloud Firestore) ──────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push notifications (FCM). Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → generate/key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional: server-side admin access (seeding, background jobs).
# Firebase console → Project settings → Service accounts → Generate new key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Writing assistant (optional) ──────────────────────────────────────────────
# Without an endpoint the assistant is a deterministic, on-device copy writer,
# NOT a language model. This URL is public and must not contain an API key.
# Connect a secured backend proxy if you want model-backed output.
NEXT_PUBLIC_AI_ENDPOINT=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@seedweloffice.com
