# ─────────────────────────────────────────────────────────────────────────────
# Seedwel Office — environment configuration
# Copy to `.env.local` for local development and add the same keys in Vercel.
# Every value below is OPTIONAL: without them the app runs in Local Demo mode
# (browser storage) so you can evaluate the whole product end-to-end.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Authentication + Cloud Firestore) ──────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push notifications (FCM). Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → generate/key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional: server-side admin access (seeding, background jobs).
# Firebase console → Project settings → Service accounts → Generate new key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── AI assistant (optional) ──────────────────────────────────────────────────
# Provide ONE of these to route AI writing through a live model.
# Without a key, Seedwel uses its built-in offline copy engine (still very good).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@seedweloffice.com
