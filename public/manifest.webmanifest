{
  "name": "Seedwel Office — Business Documents",
  "short_name": "Seedwel",
  "description": "Create invoices, quotations, receipts, CVs, proposals, contracts and more with a 144-template library built for business.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#060d18",
  "theme_color": "#0e908f",
  "categories": ["business", "productivity", "finance"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New invoice", "short_name": "Invoice", "url": "/app/new/invoice", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New quotation", "short_name": "Quotation", "url": "/app/new/quotation", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Documents", "short_name": "Documents", "url": "/app/documents" },
    { "name": "Templates", "short_name": "Templates", "url": "/app/templates" }
  ]
}
